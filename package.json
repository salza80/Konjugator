{
  "name": "@salza80/konjugator",
  "version": "0.0.4",
  "description": "",
  "author": "sally mclean",
  "main": "dist/lib/konjugator.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && npm run build:lib",
    "deploy": "npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "lint": "eslint src vite*.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build:lib": "vite build --config vite.library.config.ts && tsc -p tsconfig.lib.json",
    "prepack": "npm run build",
    "check": "npm run lint && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/salza80/Konjugator.git"
  },
  "publishConfig": {
    "type": "git",
    "registry": "https://npm.pkg.github.com/"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "type": "module",
  "engines": {
    "node": "^24.22.1"
  },
  "allowScripts": {
    "fsevents": false
  },
  "types": "dist/lib/types/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/main.d.ts",
      "import": "./dist/lib/konjugator.js"
    }
  },
  "files": [
    "dist/lib",
    "public/assets"
  ]
}
